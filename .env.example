# Jarvis Labs API (Google Gemma endpoint)
# Optional at boot; required when LLM operations are invoked
# Do NOT prefix with NEXT_PUBLIC_
JARVISLABS_API_KEY=your_jarvislabs_api_key_here
JARVISLABS_BASE_URL=https://models.jarvislabs.net/v1
JARVISLABS_MODEL=gemma-4-31b-it
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_MS=15000

# OpenAQ API Key (for ground air quality station readings)
# Optional; if omitted, falls back to Open-Meteo model data
# Do NOT prefix with NEXT_PUBLIC_
OPENAQ_API_KEY=your_openaq_api_key_here
OPENAQ_RADIUS_KM=25
OPENAQ_MAX_AGE_MINUTES=180

# Rate Limiting (requests per minute per IP/session)
RATE_LIMIT_PER_MINUTE=20

# Node Environment
NODE_ENV=development
